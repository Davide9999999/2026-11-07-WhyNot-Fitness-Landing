// Configurazione Cloudflare Worker. Indirizzo ufficiale: whynotfitnessclub.com (www e workers.dev rimandano lì, vedi assets/dominio.js).
// Il nome DEVE coincidere con quello del Worker già collegato al repo su Cloudflare.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "2026-11-07-whynot-fitness-landing",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "whynotfitnessclub.com", "custom_domain": true },
    { "pattern": "www.whynotfitnessclub.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Valori PUBBLICI del progetto Supabase (Settings > API). La chiave segreta Anthropic va come secret, mai qui.
    "SUPABASE_URL": "https://fnyvsawkdiloyujoiumx.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_AoAkme4i4S0AAG1q4jW-SQ_roh-_ke_",
    "AI_MODEL": "claude-opus-5-5",
    // Notifiche push: chiave PUBBLICA VAPID (la privata VAPID_PRIVATE_KEY e PUSH_SECRET vanno come secret su Cloudflare)
    "VAPID_PUBLIC_KEY": "BMzRtukuI9ep3kJIEaUhRzPDPwtC4BT2r2sVGmxWVJ8mg8VdLSxwJsBNoo5Gk9mKYq6wNOauJNPvTPIdk7qRkF8",
    "VAPID_SUBJECT": "mailto:whynotfitnessclubbiella@gmail.com"
  },
  "triggers": { "crons": ["* * * * *"] },
  // non cancellare le variabili aggiunte dalla dashboard Cloudflare a ogni deploy
  "keep_vars": true,
  "observability": { "enabled": true }
}
